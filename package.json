{
  "name": "md-studio",
  "version": "0.1.0",
  "private": false,
  "author": "IvanGlazyrin <glazrus97@gmail.com>",
  "license": "MIT",
  "description": "Next.js 16 studio for a local Markdown vault: wikilinks, search, callouts and inline TODOs",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "docs:stats": "node --no-warnings scripts/analyze-text.ts",
    "desktop": "electron electron/main.cjs",
    "desktop:build": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.0",
    "clsx": "^2.1.1",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.19.0",
    "lucide-react": "^1.47.0",
    "mermaid": "^12.0.0",
    "minisearch": "^7.1.1",
    "next": "^16.3.5",
    "prismjs": "^1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-zoom-pan-pinch": "^4.2.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.0.1",
    "unist-util-visit": "^5.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/katex": "^0.16.8",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.2",
    "@types/prismjs": "^1.26.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "postcss": "^8.5.2",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "unified": "^11.0.5",
    "vitest": "^5.0.1",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12",
    "concurrently": "^9.1.2"
  },
  "build": {
    "appId": "com.ivanlazyrin.mdstudio",
    "productName": "MD Studio",
    "copyright": "Copyright (c) 2026 Ivan Glazyrin",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json",
      ".next/standalone/**/*",
      "vault/**/*",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "asar": false
  },
  "main": "electron/main.cjs"
}
